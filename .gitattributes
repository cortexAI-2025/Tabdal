# Force Unix line endings for Gradle wrapper scripts
gradlew          text eol=lf
gradlew.bat      text eol=crlf

# Binary files
*.jar            binary
*.apk            binary
*.aab            binary
*.png            binary
*.jpg            binary
*.keystore       binary
*.jks            binary

# Source files
*.kt             text eol=lf
*.kts            text eol=lf
*.xml            text eol=lf
*.json           text eol=lf
*.toml           text eol=lf
*.properties     text eol=lf
*.md             text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.pro            text eol=lf
